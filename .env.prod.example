APP_NAME="Kindergarten Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kindergarten.elhadjkia.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kindergarten_db
DB_USERNAME=kindergarten_user
DB_PASSWORD=your_secure_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# SMTP config for mail sending (use your provider's credentials)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@elhadjkia.com"
MAIL_FROM_NAME="${APP_NAME}"
